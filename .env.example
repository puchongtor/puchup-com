# ─── Gemini (existing image generation) ─────────────────────────────────────
# Gemini API — required for image generation
GEMINI_API_KEY=

# Optional: image model (default gemini-2.5-flash-image)
# Paid / higher quality: GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Enable billing if quota is 0: https://ai.dev/rate-limit

# Optional: remove.bg if rembg CLI is not installed (Demo cutouts)
# REMOVE_BG_API_KEY=

# Optional: build fully static without API routes / Sanity middleware
# STATIC_EXPORT=1

# ─── Sanity.io CMS ───────────────────────────────────────────────────────────
# Create a project at https://www.sanity.io/manage then copy IDs below.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SANITY_PROJECT_TITLE=PuchUp CMS

# Root domain for subdomain routing ([sub].puchup.com → /sites/[sub])
# Local: use localhost and open http://mellow.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=puchup.com

# Optional: Sanity write token (server-only) for mutations / preview drafts / seed
# Create at https://www.sanity.io/manage → API → Tokens (Editor)
# SANITY_API_TOKEN=

# Seed demos into Studio: npm run sanity:seed-demos

# Optional: hosted Studio URL (shown as a link on /studio)
# NEXT_PUBLIC_SANITY_STUDIO_URL=https://your-studio.sanity.studio

# If Studio shows "Connect this studio…" or project/placeholder:
# 1) Confirm NEXT_PUBLIC_SANITY_PROJECT_ID in .env.local
# 2) Restart: npm run sanity  (vite injects env via sanity.cli.ts)
# 3) npm run sanity:cors   # localhost:3333 + :3000 with credentials
# 4) Sign in at http://localhost:3333
