# ─── Gemini (existing image generation) ─────────────────────────────────────
# Gemini API — required for image generation
GEMINI_API_KEY=

# Optional: image model (default gemini-2.5-flash-image)
# Paid / higher quality: GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Enable billing if quota is 0: https://ai.dev/rate-limit

# Optional: remove.bg if rembg CLI is not installed (Demo cutouts)
# REMOVE_BG_API_KEY=

# SaleDesk live app URL (separate Next app in /sale-desk — NOT static export)
NEXT_PUBLIC_SALE_URL=https://sale.puchup.com

# Contact chat (static site → SaleDesk live API)
NEXT_PUBLIC_SALE_URL=https://sale.puchup.com
NEXT_PUBLIC_CONTACT_CHAT_URL=https://sale.puchup.com/api/contact-chat

# ─── Supabase (optional inbox persistence — project name: puchup) ───────────
# Create empty project at https://supabase.com (do NOT reuse AdvancePro DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# On SaleDesk / Edge secrets (never NEXT_PUBLIC_):
#   SUPABASE_SERVICE_ROLE_KEY=
#   GEMINI_API_KEY=              # preferred for contact AI
#   ANTHROPIC_API_KEY=           # fallback
#   LINE_NOTIFY_TOKEN=           # notify @masterpuch operator
#   LINE_CHANNEL_ACCESS_TOKEN=   # Messaging API push
#   LINE_ADMIN_USER_ID=          # your LINE user id who manages OA
#   CONTACT_ALERT_WEBHOOK=       # optional Discord/Make.com
# Deploy SaleDesk API: cd sale-desk && npx vercel --prod
# Optional Edge: npx supabase functions deploy contact-chat

# ─── Sanity.io CMS ───────────────────────────────────────────────────────────
# Create a project at https://www.sanity.io/manage then copy IDs below.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SANITY_PROJECT_TITLE=PuchUp CMS

# Root domain for subdomain routing ([sub].puchup.com → /sites/[sub])
# Local: use localhost and open http://mellow.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=puchup.com

# Optional: Sanity write token (server-only) for mutations / preview drafts / seed
# Create at https://www.sanity.io/manage → API → Tokens (Editor)
# SANITY_API_TOKEN=

# Seed Project ONE demos (5 live templates) into Studio:
# npm run sanity:seed-project-one

# Optional: hosted Studio URL shown/embedded at https://puchup.com/admin
# After: npm run sanity:deploy  →  https://puchup.sanity.studio
NEXT_PUBLIC_SANITY_STUDIO_URL=https://puchup.sanity.studio

# If Studio shows "Connect this studio…" or project/placeholder:
# 1) Confirm NEXT_PUBLIC_SANITY_PROJECT_ID in .env.local
# 2) Restart: npm run sanity  (vite injects env via sanity.cli.ts)
# 3) npm run sanity:cors   # localhost:3333 + :3000 with credentials
# 4) Sign in at http://localhost:3333

# Vercel: set the same NEXT_PUBLIC_SANITY_* vars in Project Settings → Environment Variables.
# After Sanity publish, trigger a Vercel Deploy Hook instead of ISR (saves function credits).
